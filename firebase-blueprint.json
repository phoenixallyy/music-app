{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control (owner or friend/listener)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["owner", "friend"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role", "createdAt"]
    },
    "Song": {
      "title": "Song",
      "description": "Song metadata for uploaded audio files stored in private storage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "artist": { "type": "string", "maxLength": 200 },
        "album": { "type": "string", "maxLength": 200 },
        "genre": { "type": "string", "maxLength": 100 },
        "duration": { "type": "number" },
        "fileSize": { "type": "number" },
        "storagePath": { "type": "string", "maxLength": 500 },
        "artworkUrl": { "type": "string", "maxLength": 500 },
        "uploaderId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "artist", "duration", "storagePath", "uploaderId", "createdAt"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "User-curated playlists with visibility and friend sharing controls",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "artworkUrl": { "type": "string", "maxLength": 500 },
        "isPublicToFriends": { "type": "boolean" },
        "sharedWithUserIds": {
          "type": "array"
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "name", "isPublicToFriends", "createdAt", "updatedAt"]
    },
    "PlaylistTrack": {
      "title": "PlaylistTrack",
      "description": "Normalized junction entity linking songs to playlists with order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "playlistId": { "type": "string" },
        "songId": { "type": "string" },
        "position": { "type": "number" },
        "addedAt": { "type": "string" }
      },
      "required": ["id", "playlistId", "songId", "position", "addedAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "Secure invitation token generated by owner to invite friends with assigned playlists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email" },
        "assignedPlaylistIds": { "type": "array" },
        "createdBy": { "type": "string" },
        "expiresAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "acceptedByUserId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "token", "email", "assignedPlaylistIds", "createdBy", "expiresAt", "status", "createdAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "User favorited / liked songs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "songId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "songId", "createdAt"]
    },
    "ListeningHistory": {
      "title": "ListeningHistory",
      "description": "Record of played songs for recently played lists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "songId": { "type": "string" },
        "playedAt": { "type": "string" }
      },
      "required": ["id", "userId", "songId", "playedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile with role definitions"
    },
    "/songs/{songId}": {
      "schema": "Song",
      "description": "Metadata for uploaded songs in library"
    },
    "/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "Playlists managed by owner and shared with friends"
    },
    "/playlists/{playlistId}/tracks/{trackId}": {
      "schema": "PlaylistTrack",
      "description": "Ordered songs inside a playlist"
    },
    "/invitations/{invitationId}": {
      "schema": "Invitation",
      "description": "Pending and redeemed invite tokens"
    },
    "/favorites/{favoriteId}": {
      "schema": "Favorite",
      "description": "Songs marked as favorites by users"
    },
    "/listeningHistory/{historyId}": {
      "schema": "ListeningHistory",
      "description": "Playback activity history"
    }
  }
}
