rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins / Owners Collection (Privileged lookup)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Provisioned exclusively via trusted server/admin SDK
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'friend'
        && request.resource.data.keys().hasAll(['id', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'avatarUrl', 'createdAt']);
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl']))
        || isOwner()
      );
      allow delete: if isOwner();
    }

    // Songs Collection
    match /songs/{songId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isOwner();
    }

    // Playlists Collection
    match /playlists/{playlistId} {
      // Readable if owner, public to friends, or explicitly shared with the user
      allow get: if isSignedIn() && (
        isOwner()
        || resource.data.isPublicToFriends == true
        || (resource.data.sharedWithUserIds is list && request.auth.uid in resource.data.sharedWithUserIds)
      );
      allow list: if isSignedIn() && (
        isOwner()
        || resource.data.isPublicToFriends == true
        || (resource.data.sharedWithUserIds is list && request.auth.uid in resource.data.sharedWithUserIds)
      );
      allow create, update, delete: if isOwner();

      // Tracks sub-collection
      match /tracks/{trackId} {
        allow read: if isSignedIn() && (
          isOwner()
          || get(/databases/$(database)/documents/playlists/$(playlistId)).data.isPublicToFriends == true
          || (get(/databases/$(database)/documents/playlists/$(playlistId)).data.sharedWithUserIds is list
              && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.sharedWithUserIds)
        );
        allow write: if isOwner();
      }
    }

    // Invitations Collection (Server & Owner managed)
    match /invitations/{invitationId} {
      allow read: if isOwner() || isSignedIn();
      allow write: if isOwner();
    }

    // User Favorites Collection
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User Listening History
    match /listeningHistory/{historyId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
